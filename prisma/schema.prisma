generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Moneda {
  ARS
  USD
}

enum TipoMovimientoFondo {
  GASTO
  APORTE
}

enum EstadoProyecto {
  ACTIVO
  PAUSADO
  FINALIZADO
}

enum EstadoUnidad {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum EstadoPedido {
  PENDIENTE
  PARCIAL
  COMPLETO
  CANCELADO
}

enum TipoAcopio {
  MONTO
  MATERIAL
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum EstadoTramiteMunicipal {
  PENDIENTE
  PRESENTADO
}

enum ModalidadVenta {
  CONTADO
  FINANCIADO
}

model User {
  id                String   @id @default(cuid())
  // Con lo que se inicia sesión. El email pasó a ser un dato de contacto
  // opcional: hay gente del estudio que no tiene o no lo usa.
  usuario           String   @unique
  email             String?  @unique
  passwordHash      String
  nombre            String
  esAdmin           Boolean  @default(false)
  // Claves de las secciones (ver src/lib/paginas.ts) a las que este usuario
  // tiene acceso. Los administradores (esAdmin) siempre tienen acceso a todo,
  // sin importar este campo.
  paginasPermitidas String[] @default([])
  createdAt         DateTime @default(now())

  pedidosCreados   Pedido[]  @relation("PedidoCreadoPor")
  entregasCargadas Entrega[] @relation("EntregaRegistradaPor")

  tareasCreadas   Tarea[]         @relation("TareaCreadaPor")
  tareasAsignadas TareaAsignado[]
}

model Proyecto {
  id                   String         @id @default(cuid())
  nombre               String
  barrio               String?
  direccion            String?
  estado               EstadoProyecto @default(ACTIVO)
  descripcion          String?
  imagenUrl            String?
  // Folleto de venta de la obra (un PDF, casi siempre). Vive acá y no como un
  // Documento más porque no es documentación de obra: no se presenta en ningún
  // lado, no tiene estado pendiente/presentado y se abre de un clic desde la
  // portada del proyecto. Un solo archivo por obra; subir otro reemplaza al
  // anterior. El nombre se guarda aparte de la URL para poder mostrarlo tal
  // como lo subieron, sin tener que leerlo de la URL del blob (que lleva un
  // sufijo aleatorio pegado).
  brochureUrl          String?
  brochureNombre       String?
  // EN DESUSO. Era la cantidad de pisos por encima de planta baja, y con eso
  // Documentación generaba los planos numerados ("Planta baja", "Piso 1", ...).
  // Contar pisos nunca alcanzó: una obra real tiene "PLANTA TIPO" (varios pisos
  // iguales que se computan una sola vez), subsuelos y azoteas, nombres que no
  // salen de contar. Ahora esos nombres se cargan a mano en NivelProyecto y de
  // ahí sale el corte por planta del cómputo.
  //
  // La columna queda por los valores viejos, que son lo único que sobrevive de
  // cómo estaba cargada cada obra antes del cambio. No la lee nadie.
  cantidadPisos        Int            @default(0)
  // Metros cuadrados vendibles totales de la obra. Es el divisor de los
  // costos por m² del resumen de Flujo de fondos (incidencia del terreno y
  // costo de construcción). Se carga a mano desde la pestaña "Datos del
  // proyecto" y no se deriva de la suma de UnidadProyecto.m2 porque el
  // total vendible se conoce desde el anteproyecto, mucho antes de tener
  // cargada cada unidad.
  m2Vendibles          Decimal?       @db.Decimal(10, 2)
  // Porcentaje de honorarios que cobra el estudio sobre los gastos de esta
  // obra (ej. 12.00). Se carga a mano desde "Datos del proyecto" y puede
  // variar de obra en obra. En null significa "sin definir": la calculadora
  // de honorarios no propone ningún monto hasta que se cargue.
  porcentajeHonorarios Decimal?       @db.Decimal(5, 2)
  // Arranque y largo de la obra: los dos datos que definen la línea de tiempo
  // del presupuesto (ver PresupuestoItem). Sin ellos la solapa Presupuesto no
  // tiene contra qué ubicar las barras, y es lo primero que pide.
  //
  // La duración va en meses y no como fecha de fin porque así se piensa y así
  // se carga ("la obra son 24 meses"). La fecha de fin se deriva.
  fechaInicio          DateTime?
  duracionMeses        Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  pedidos               Pedido[]
  acopios               Acopio[]
  tramitesMunicipales   TramiteMunicipal[]
  documentos            Documento[]
  // Tipos de documento generados automáticamente para este proyecto (planos
  // por piso). Ver DocumentoTipo.proyectoId.
  documentoTiposPorPiso DocumentoTipo[]    @relation("DocumentoTipoProyecto")

  // Flujo de fondos: inversores participantes y movimientos de dinero.
  inversores       ProyectoInversor[]
  movimientosFondo MovimientoFondo[]
  // Datos del proyecto (Flujo de fondos): catálogos propios de cada obra,
  // que después se van a poder vincular con las ventas del proyecto.
  mediosPago       MedioPago[]
  unidades         UnidadProyecto[]
  niveles          NivelProyecto[]
  ventas           Venta[]
  tareas           Tarea[]
  presupuesto      PresupuestoItem[]
  facturas         Factura[]
  computo          ComputoItem[]
  computoSecciones ComputoSeccion[]
  computoFechas    ComputoFecha[]
}

// Catálogo de categorías de la pestaña "Municipal": igual que
// DocumentoCategoria, se crean, renombran y eliminan libremente desde la UI,
// sin tocar código.
model CategoriaMunicipal {
  id        String   @id @default(cuid())
  nombre    String   @unique
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  etapas EtapaMunicipal[]
  tipos  TramiteMunicipalTipo[]
}

// Agrupa tipos de trámite dentro de una categoría (ej. "Inicio" dentro de
// "Obra"). También editable libremente desde la UI. Una categoría que no se
// subdivide simplemente no tiene etapas cargadas.
model EtapaMunicipal {
  id          String             @id @default(cuid())
  categoriaId String
  categoria   CategoriaMunicipal @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  orden       Int                @default(0)
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  tipos TramiteMunicipalTipo[]

  @@unique([categoriaId, nombre])
  @@index([categoriaId])
}

// Catálogo de documentos/trámites requeridos por categoría (y, dentro de
// algunas categorías, por etapa). Se puede ampliar desde la UI (categorías y
// etapas) o agregando tipos nuevos.
model TramiteMunicipalTipo {
  id          String             @id @default(cuid())
  categoriaId String
  categoria   CategoriaMunicipal @relation(fields: [categoriaId], references: [id])
  // Agrupa varios tipos dentro de una categoría (ej. "Inicio" en Obra).
  // Null si la categoría no se subdivide en etapas.
  etapaId     String?
  etapa       EtapaMunicipal?    @relation(fields: [etapaId], references: [id])
  nombre      String
  // Texto de ayuda/instrucciones para quien carga el trámite.
  descripcion String?
  orden       Int                @default(0)
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  tramites TramiteMunicipal[]

  @@unique([categoriaId, etapaId, nombre])
  @@index([categoriaId])
  @@index([etapaId])
}

// Instancia por proyecto de cada tipo de trámite del catálogo: se crea la
// primera vez que alguien marca el estado, adjunta un archivo o escribe una
// nota para ese trámite en ese proyecto.
model TramiteMunicipal {
  id            String                 @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto               @relation(fields: [proyectoId], references: [id])
  tipoId        String
  tipo          TramiteMunicipalTipo   @relation(fields: [tipoId], references: [id])
  // Se actualiza automáticamente: PRESENTADO al adjuntar el archivo,
  // PENDIENTE si se lo quita. No se edita a mano.
  estado        EstadoTramiteMunicipal @default(PENDIENTE)
  notas         String?
  // Un solo archivo por trámite (subir uno nuevo reemplaza al anterior).
  archivoNombre String?
  archivoUrl    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([proyectoId, tipoId])
  @@index([proyectoId])
}

enum EstadoDocumento {
  PENDIENTE
  PRESENTADO
}

// Catálogo de categorías de la pestaña "Documentación" (a diferencia de
// Municipal, acá las categorías no son un enum fijo: se crean y eliminan
// libremente desde la UI, sin tocar código).
model DocumentoCategoria {
  id          String   @id @default(cuid())
  nombre      String   @unique
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  // Si es true, esta categoría no tiene un catálogo de tipos compartido: sus
  // documentos son propios de cada obra (DocumentoTipo.proyectoId con valor),
  // porque las plantas de una obra no son las de otra.
  //
  // Hubo una versión que además los generaba sola, un plano por nivel cargado
  // en NivelProyecto. Se sacó: el árbol está cargado a mano, con nombres
  // propios por subsección y con dibujos que no son plantas (FUNDACIONES,
  // CORTE LONGITUDINAL), y generar encima duplicaba y barría. Hoy la bandera
  // sólo decide de quién son los documentos, no quién los escribe.
  porPiso     Boolean  @default(false)
  // EN DESUSO, junto con la generación automática. Era el prefijo con el que
  // se nombraban los planos de esta categoría (ej. "S/" -> S/PLANTA BAJA).
  prefijoPiso String?
  // EN DESUSO, junto con la generación automática. Era la lista de
  // subsecciones a generar (ej. instalaciones: sanitaria, gas, ...). Las
  // subsecciones que hoy existen se escribieron a mano, en
  // DocumentoTipo.subSeccion, y no salen de acá.
  subTipos    String[] @default([])
  createdAt   DateTime @default(now())

  tipos DocumentoTipo[]
}

// Catálogo de tipos de documento dentro de una categoría. Los tipos
// "globales" (proyectoId null) se crean y eliminan libremente desde la UI
// (ver src/actions/documentos.ts) y son compartidos por todos los
// proyectos. Los tipos con proyectoId asignado son generados
// automáticamente para ese proyecto puntual (categorías "por piso").
model DocumentoTipo {
  id              String             @id @default(cuid())
  categoriaId     String
  categoria       DocumentoCategoria @relation(fields: [categoriaId], references: [id])
  // Null = tipo global (compartido). Con valor = generado para ese
  // proyecto puntual (planos por piso).
  proyectoId      String?
  proyecto        Proyecto?          @relation("DocumentoTipoProyecto", fields: [proyectoId], references: [id])
  nombre          String
  descripcion     String?
  // Si tiene valor, agrupa este tipo dentro de una subsección dentro de su
  // categoría (ej. "Instalación sanitaria" dentro de "Instalaciones"), cada
  // una con su propio acordeón y barra de progreso. Null si la categoría no
  // se subdivide.
  subSeccion      String?
  // Un nivel más de anidamiento, ya dentro de la subsección: si tiene
  // valor, este tipo es un subitem del tipo apuntado (ej. "Cañerías"
  // adentro de "Caldera", que a su vez está en la subsección "Instalación
  // de calefacción"). Null = item de primer nivel, que es como quedaron
  // todos los que ya existían cuando se agregó la columna.
  //
  // Un tipo con hijos hace de carpeta y no se presenta él mismo: lo que se
  // marca presentado son los hijos, y su progreso es el de ellos.
  parentId        String?
  parent          DocumentoTipo?     @relation("DocumentoTipoHijos", fields: [parentId], references: [id])
  hijos           DocumentoTipo[]    @relation("DocumentoTipoHijos")
  orden           Int                @default(0)
  activo          Boolean            @default(true)
  // Si es true, el usuario lo eliminó a mano para este proyecto puntual:
  // sincronizarDocumentosPorPiso no lo vuelve a crear/reactivar aunque siga
  // en la lista de pisos/sub-tipos esperada (evita "resucitar" algo que se
  // borró a propósito la próxima vez que se guarda el proyecto).
  excluido        Boolean            @default(false)
  // True = lo creó un generador automático. False = lo escribió una persona.
  //
  // Hoy está en false en todas las filas, porque la generación de planos por
  // nivel se sacó. Queda como la marca que haría falta si se retoma: es lo
  // único que separa "plano de una planta que ya no existe" de "dibujo que
  // alguien cargó y que nunca fue una planta". Sin ella, limpiar lo viejo se
  // hacía por descarte —lo que no está en la lista de niveles sobra— y se
  // llevaba puestos FUNDACIONES, CORTE LONGITUDINAL y DETALLE VIGA VOLADIZO,
  // que viven dentro de una categoría por piso sin ser pisos.
  generado        Boolean            @default(false)
  // Si tiene valor, este tipo es la versión propia de un proyecto que
  // reemplaza a uno del catálogo compartido: mientras exista, el original
  // no se lista en ese proyecto. Es lo que permite renombrar o reordenar un
  // documento compartido sin pisárselo a las demás obras; borrar la copia
  // devuelve el compartido, sin dejar rastro.
  reemplazaTipoId String?
  reemplaza       DocumentoTipo?     @relation("DocumentoTipoReemplazo", fields: [reemplazaTipoId], references: [id])
  reemplazadoPor  DocumentoTipo[]    @relation("DocumentoTipoReemplazo")
  createdAt       DateTime           @default(now())

  documentos Documento[]

  // Nombre explícito: el que Prisma armaría solo con estas cinco columnas
  // pasa los 63 caracteres que aguanta Postgres y quedaría truncado.
  @@unique([categoriaId, proyectoId, subSeccion, parentId, nombre], map: "DocumentoTipo_scope_nombre_key")
  @@index([categoriaId])
  @@index([proyectoId])
  @@index([parentId])
  @@index([reemplazaTipoId])
}

// Instancia por proyecto de cada tipo de documento del catálogo: se crea la
// primera vez que alguien adjunta un archivo o escribe una nota para ese
// documento en ese proyecto.
model Documento {
  id            String          @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto        @relation(fields: [proyectoId], references: [id])
  tipoId        String
  tipo          DocumentoTipo   @relation(fields: [tipoId], references: [id])
  // Se actualiza automáticamente: PRESENTADO al adjuntar el archivo,
  // PENDIENTE si se lo quita. No se edita a mano.
  estado        EstadoDocumento @default(PENDIENTE)
  notas         String?
  // Un solo archivo por documento (subir uno nuevo reemplaza al anterior).
  archivoNombre String?
  archivoUrl    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // La tarea que se crea desde este plano (botón "Nueva tarea" en
  // Documentación) para ir a buscar lo que falta. Puede haber varias en el
  // tiempo (una completada no impide crear otra más adelante), pero las
  // acciones de tareas no dejan que haya más de una activa a la vez: el
  // puntito de este plano tiene que mostrar un solo color sin ambigüedad.
  tareas Tarea[]

  @@unique([proyectoId, tipoId])
  @@index([proyectoId])
}

model Proveedor {
  id        String   @id @default(cuid())
  // Código corto para identificar al proveedor (ej. PROV-0001).
  // Se genera automáticamente al crearlo y se puede editar después.
  codigo    String   @unique
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  cuit      String?
  notas     String?
  createdAt DateTime @default(now())

  pedidos Pedido[]
  rubros  Rubro[]
  acopios Acopio[]

  movimientosFondo MovimientoFondo[]
  facturas         Factura[]
}

model Rubro {
  id            String   @id @default(cuid())
  nombre        String   @unique
  // Prefijo (2-4 letras) usado para armar el código de los materiales de
  // este rubro (ej. HIE de "Hierros" -> HIE-001, HIE-002, ...).
  codigoPrefijo String?  @unique
  orden         Int      @default(0)
  createdAt     DateTime @default(now())

  // Honorarios del estudio (ver src/lib/honorarios.ts).
  //
  // `pagaHonorarios`: si los gastos de este rubro entran en la base sobre la
  // que se calcula el honorario. Arranca en true porque la mayoría paga; se
  // destilda la compra del terreno, que es la excepción.
  //
  // `esHonorarios`: marca el rubro donde se cargan los honorarios en sí. Es
  // el que dispara la calculadora y el que corta el período (la base son los
  // gastos posteriores al último movimiento de este rubro). Debería haber uno
  // solo: al marcarlo se desmarca el anterior (ver src/actions/rubros.ts).
  pagaHonorarios Boolean @default(true)
  esHonorarios   Boolean @default(false)

  // Si este rubro aparece en la pantalla de Cómputos. Están marcados los de
  // obra, de ESTRUCTURA H°A a REVESTIMIENTOS: son los que se miden en plano y
  // se mandan a cotizar por cantidad.
  //
  // Quedan afuera los que no se computan: el terreno, los gastos municipales,
  // la gestoría y los gastos fijos no tienen m² ni unidades que contar, y los
  // honorarios salen de un porcentaje sobre el resto.
  //
  // Es una marca y no un rango de posiciones (del 5 al 23) a propósito: el
  // rango se rompe solo la primera vez que alguien arrastra un rubro o carga
  // uno nuevo en el medio, y lo haría en silencio.
  seComputa Boolean @default(false)

  proveedores Proveedor[]
  materiales  Material[]
  subrubros   Subrubro[]

  movimientosFondo MovimientoFondo[]
  tareas           Tarea[]
  presupuesto      PresupuestoItem[]
  facturas         Factura[]
  itemTipos        ComputoItemTipo[]
  computo          ComputoItem[]
  computoSecciones ComputoSeccion[]
  computoFechas    ComputoFecha[]
}

// De qué lado de la obra es un cómputo: lo que se compra, o lo que se paga por
// hacerlo.
//
// Son dos cómputos distintos y no dos columnas del mismo, porque no se miden
// las mismas cosas. Del lado del material se computan m³ de hormigón y kilos de
// hierro; del lado de la mano de obra se computan m² de encofrado armado y
// jornales. Se contratan aparte, se cotizan aparte y se pagan aparte.
enum TipoComputo {
  MATERIALES
  MANO_DE_OBRA
}

// Cuándo se tocó por última vez un número del cómputo de este rubro y lado
// (ver TipoComputo) en esta obra: una celda medida, un renglón del detalle o
// una fila derivada. Es lo que se muestra arriba a la derecha de la grilla y
// lo que se imprime en el PDF — sin esto, quien lo recibe no tiene forma de
// saber si lo que tiene en la mano es la última versión o una de hace un mes.
//
// Es UNA por rubro y lado, y no una por sección ni una por obra entera: un
// cómputo (MUROS, REVOQUES, CONTRAPISOS...) son varias secciones a la vez, y
// lo que importa es cuándo se tocó cualquiera de ellas, no cuál en particular.
// Vive en su propia tabla y no como columna de ComputoSeccion porque la fecha
// es del conjunto, no de una fila: así alcanza con una fila acá por cada
// rubro y lado que se empezó a cargar, en vez de tener que mirar el máximo
// entre varias secciones cada vez que hay que mostrarla.
//
// Nace recién cuando se toca el primer número: un rubro sin cómputo cargado no
// tiene "última modificación", tiene nada, y una fila con la fecha de hoy
// mentiría que ya se empezó.
model ComputoFecha {
  id           String      @id @default(cuid())
  proyectoId   String
  proyecto     Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rubroId      String
  rubro        Rubro       @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  tipo         TipoComputo
  modificadoEl DateTime    @default(now())

  @@unique([proyectoId, rubroId, tipo])
  @@index([proyectoId])
}

// El corte del cómputo adentro de un rubro: MUROS, REVOQUES, CONTRAPISOS e
// IMPERMEABILIZACIONES adentro de ALBAÑILERÍA, de un lado o del otro del
// switch (ver TipoComputo).
//
// Es una tabla propia y no Subrubro a propósito, aunque ahora los dos partan
// por materiales y mano de obra. Subrubro es del lado de la plata: con él están
// clasificados cientos de movimientos de fondo y de facturas, y meter ahí
// adentro las secciones de albañilería ensuciaría ese desplegable para siempre.
// Acá el nombre es de la obra y se escribe obra por obra; allá es de la
// contabilidad y es fijo.
//
// Va por proyecto y no por rubro global: las secciones se arman obra por obra,
// mirando esa obra, y después se copian a las demás cuando se decide que
// sirven. Una plantilla compartida obligaría a acertarle a todas las obras de
// una, que es justo lo que no se puede al empezar.
model ComputoSeccion {
  id         String      @id @default(cuid())
  proyectoId String
  proyecto   Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rubroId    String
  rubro      Rubro       @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  // De qué lado del switch vive. Default MATERIALES porque es el lado con el
  // que se arranca a computar y porque es lo que eran todas las secciones
  // cargadas antes de que el switch existiera.
  tipo       TipoComputo @default(MATERIALES)
  nombre     String
  orden      Int         @default(0)
  createdAt  DateTime    @default(now())
  // En qué orden se leen las filas de ESTA grilla: ["nivel:abc", "extra:def"].
  //
  // Va acá y no en el orden de los niveles porque las dos clases de fila se
  // mezclan: SALA DE MÁQUINAS tiene que poder quedar entre el 4TO PISO y la
  // AZOTEA, y niveles y filas extra viven en tablas distintas, así que ningún
  // número propio de cada una las puede intercalar.
  //
  // Es una lista de claves y no una tabla de relaciones a propósito: es un
  // orden de pantalla, no un vínculo. Lo que se borró queda como clave muerta y
  // se ignora al dibujar, y lo que se creó después no está en la lista y cae al
  // final, que es donde uno espera encontrar lo recién agregado. Vacío quiere
  // decir "sin tocar": los niveles en el orden de la obra y las filas extra
  // atrás.
  ordenFilas String[]    @default([])

  items      ComputoItem[]
  filasExtra ComputoFilaExtra[]

  // El tipo entra en la clave: "HORMIGÓN" puede existir de los dos lados, y son
  // dos secciones distintas con sus propias columnas y su propio total. Lo que
  // se sigue prohibiendo es repetir el nombre del mismo lado.
  @@unique([proyectoId, rubroId, tipo, nombre])
  @@index([proyectoId])
  @@index([rubroId])
}

// Una fila de la grilla que no es un nivel de la obra: "SALA DE MÁQUINAS"
// adentro de MUROS, "TANQUE" adentro de IMPERMEABILIZACIONES.
//
// Los niveles son la estructura de la obra y valen para todo el cómputo: si
// hay un 4° piso, hay 4° piso en muros, en revoques y en pisos. Por eso al
// crear un ítem aparecen solos, en todas las grillas.
//
// Esto es lo otro: el caso puntual que existe en una sección y en ninguna más.
// Va colgado de la sección y no del proyecto justamente para eso — agregarlo en
// MUROS no tiene por qué ensuciar la grilla de REVOQUES, donde esa fila estaría
// siempre vacía. Si en REVOQUES también hace falta, se agrega de nuevo ahí.
model ComputoFilaExtra {
  id        String         @id @default(cuid())
  seccionId String
  seccion   ComputoSeccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int            @default(0)
  createdAt DateTime       @default(now())

  mediciones ComputoMedicion[]

  @@unique([seccionId, nombre])
  @@index([seccionId])
}

// Subcategoría dentro de un Rubro, usada para clasificar con más detalle los
// gastos de Flujo de fondos (ej. dentro de "Gastos municipales": Áridos,
// Derechos de construcción, Encomiendas).
model Subrubro {
  id        String   @id @default(cuid())
  rubroId   String
  rubro     Rubro    @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  movimientosFondo MovimientoFondo[]
  presupuesto      PresupuestoItem[]
  facturas         Factura[]
  itemTipos        ComputoItemTipo[]
  computo          ComputoItem[]

  @@unique([rubroId, nombre])
  @@index([rubroId])
}

// Participación (%) de un inversor en un proyecto puntual. Los inversores se
// cargan directamente dentro de cada obra (no hay catálogo global), ya que
// cada proyecto maneja su propia lista de inversores/socios. A partir de acá
// se calculan sus aportes (movimientos tipo APORTE) y su parte proporcional
// de ventas y gastos para el resumen de inversión.
model ProyectoInversor {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre     String
  porcentaje Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  movimientos MovimientoFondo[]

  @@unique([proyectoId, nombre])
  @@index([proyectoId])
}

// Medio de pago propio de cada proyecto (ej. Efectivo, Transferencia,
// Cheque), para clasificar los movimientos de Flujo de fondos. Reemplaza a
// una lista fija global: cada obra carga los medios de pago que usa.
model MedioPago {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre     String
  // Marca los pagos que se hacen con factura: el gasto cuenta como facturado
  // (con IVA) en el resumen de flujo de fondos.
  incluyeIva Boolean  @default(false)
  createdAt  DateTime @default(now())

  movimientos MovimientoFondo[]
  ventas      Venta[]

  @@unique([proyectoId, nombre])
  @@index([proyectoId])
}

// Unidad del edificio/proyecto (ej. departamento, cochera) cargada por obra,
// vinculada 1 a 1 con su venta (ver Venta.unidadId).
model UnidadProyecto {
  id         String       @id @default(cuid())
  proyectoId String
  proyecto   Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre     String
  tipo       String?
  m2         Decimal?     @db.Decimal(8, 2)
  estado     EstadoUnidad @default(DISPONIBLE)
  createdAt  DateTime     @default(now())

  venta Venta?

  @@unique([proyectoId, nombre])
  @@index([proyectoId])
}

// Un nivel de la obra: "PLANTA BAJA", "PLANTA TIPO", "4TO PISO", "AZOTEA".
//
// Es una tabla y no una lista derivada de Proyecto.cantidadPisos porque los
// niveles reales de una obra no salen de contar. "Planta tipo" son cuatro pisos
// iguales que se computan una sola vez; un subsuelo o una sala de máquinas no
// son un piso más; y el nombre con el que se los llama en la obra es el que
// tiene que aparecer en el cómputo y en el papel que se manda a cotizar.
// Generarlos automáticamente obligaba a renombrarlos siempre a mano, así que se
// cargan a mano desde el principio, en "Editar datos" de la portada.
//
// Es la única fuente de los niveles, y hoy su único lector es el cómputo: de
// acá sale el corte por planta de cada ítem. Documentación no los usa.
//
// `orden` es de abajo hacia arriba y lo decide el usuario arrastrando: no se
// puede deducir del nombre, y el cómputo se lee subiendo por la obra.
//
// No hay ningún nivel obligatorio ni creado por defecto. Una obra sin niveles
// cargados no está rota: el cómputo cae en "Toda la obra" hasta que se carguen.
model NivelProyecto {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  mediciones ComputoMedicion[]

  @@unique([proyectoId, nombre])
  @@index([proyectoId])
}

// Venta de una unidad del proyecto a un comprador. Cada unidad se vende una
// sola vez (relación 1 a 1 con UnidadProyecto, ver unidadId @unique): al
// cargar la venta la unidad pasa a estado VENDIDA automáticamente (ver
// src/actions/ventas.ts), y si se borra la venta vuelve a DISPONIBLE.
// El cobro de anticipo/cuotas se sigue en VentaCuota, a propósito separado
// de Flujo de fondos (no genera movimientos ahí).
model Venta {
  id              String         @id @default(cuid())
  proyectoId      String
  proyecto        Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  unidadId        String         @unique
  unidad          UnidadProyecto @relation(fields: [unidadId], references: [id])
  compradorNombre String
  fecha           DateTime
  moneda          Moneda
  precioTotal     Decimal        @db.Decimal(14, 2)
  modalidad       ModalidadVenta
  medioPagoId     String?
  medioPago       MedioPago?     @relation(fields: [medioPagoId], references: [id])
  notas           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cuotas VentaCuota[]

  @@index([proyectoId])
  @@index([medioPagoId])
}

// Pago planeado de una venta: el anticipo (esAnticipo = true, numero = 0) y
// las cuotas siguientes (numero 1..N) para ventas FINANCIADO. En una venta
// CONTADO se carga un solo registro (esAnticipo = false, numero = 1) con el
// precio total, para poder marcar el cobro con el mismo mecanismo. Montos y
// fechas se calculan automáticamente al cargar la venta (cuotas iguales,
// vencimiento mensual) pero son editables antes de guardar o después.
model VentaCuota {
  id         String    @id @default(cuid())
  ventaId    String
  venta      Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  numero     Int
  esAnticipo Boolean   @default(false)
  fecha      DateTime
  monto      Decimal   @db.Decimal(14, 2)
  cobrada    Boolean   @default(false)
  fechaCobro DateTime?
  createdAt  DateTime  @default(now())

  @@index([ventaId])
}

// Movimiento de dinero de un proyecto: un gasto (asignado a rubro/subrubro)
// o un aporte de un inversor. Es la base de la línea de tiempo de Flujo de
// fondos. El tipo de cambio es el vigente en la fecha del movimiento, para
// poder ver el equivalente en la otra moneda.
model MovimientoFondo {
  id          String              @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tipo        TipoMovimientoFondo
  fecha       DateTime
  descripcion String
  monto       Decimal             @db.Decimal(14, 2)
  moneda      Moneda
  tipoCambio  Decimal?            @db.Decimal(10, 4)
  notas       String?
  medioPagoId String?
  medioPago   MedioPago?          @relation(fields: [medioPagoId], references: [id])
  // Los dos papeles de un gasto, en campos separados a propósito: el
  // comprobante es la constancia de que se pagó (la transferencia, el recibo)
  // y la factura es el respaldo fiscal. A fin de mes van a carpetas distintas,
  // así que meterlos en un solo adjunto obligaría a abrirlos uno por uno para
  // saber cuál es cuál.
  archivoUrl  String?
  facturaUrl  String?
  createdAt   DateTime            @default(now())

  // Solo para tipo = GASTO
  rubroId     String?
  rubro       Rubro?     @relation(fields: [rubroId], references: [id])
  subrubroId  String?
  subrubro    Subrubro?  @relation(fields: [subrubroId], references: [id])
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  // Solo para tipo = APORTE
  proyectoInversorId String?
  proyectoInversor   ProyectoInversor? @relation(fields: [proyectoInversorId], references: [id])

  // Factura que este gasto cancela, total o parcialmente. Los gastos sueltos
  // (el corralón que se paga sin comprobante) no tienen ninguna y siguen
  // cargándose como siempre. Ver Factura para por qué el pago vive acá y no
  // como un modelo aparte.
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([rubroId])
  @@index([subrubroId])
  @@index([proveedorId])
  @@index([proyectoInversorId])
  @@index([medioPagoId])
  @@index([facturaId])
  @@index([fecha])
}

/// Una factura de proveedor: una deuda con fecha.
///
/// Es lo que distingue "lo que debo" de "lo que gasté", que hasta ahora eran
/// la misma cosa. Una factura NO es un gasto: el gasto sigue siendo el
/// MovimientoFondo que la paga. Si se contara la factura además del pago, el
/// resumen del proyecto duplicaría cada peso.
///
/// El pago vive en MovimientoFondo.facturaId y no en un modelo aparte porque
/// el pago ya ES un gasto, con su rubro, su medio de pago y su fecha. Como
/// una factura puede tener varios pagos, el pago parcial sale gratis: el
/// saldo es el monto menos la suma de lo cobrado (ver src/lib/facturas.ts).
///
/// El rubro se guarda acá y no se toma del pedido porque una factura puede no
/// tener pedido detrás (honorarios, un servicio) y porque es lo que el pago
/// hereda al generarse.
model Factura {
  id               String    @id @default(cuid())
  proyectoId       String
  proyecto         Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proveedorId      String
  proveedor        Proveedor @relation(fields: [proveedorId], references: [id])
  /// Número tal como figura en el papel (ej. "A-0001-00012345").
  numero           String
  fecha            DateTime
  /// Cuándo vence. Opcional: muchas facturas llegan sin fecha pactada y se
  /// pagan cuando se puede. Las que no la tienen quedan en su propio grupo,
  /// sin ensuciar el orden de las que sí vencen.
  fechaVencimiento DateTime?
  /// El total que dice la factura, con IVA y descuentos ya aplicados. Se carga
  /// a mano: los precios del pedido no incluyen ninguna de esas dos cosas.
  monto            Decimal   @db.Decimal(14, 2)
  moneda           Moneda
  tipoCambio       Decimal?  @db.Decimal(10, 4)

  rubroId    String
  rubro      Rubro     @relation(fields: [rubroId], references: [id])
  subrubroId String?
  subrubro   Subrubro? @relation(fields: [subrubroId], references: [id])

  archivoUrl String?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Los pedidos que esta factura respalda. Puede ser ninguno.
  pedidos Pedido[]
  /// Los gastos que la cancelan. Puede ser más de uno si se paga en partes.
  pagos   MovimientoFondo[]

  @@unique([proveedorId, numero])
  @@index([proyectoId])
  @@index([proveedorId])
  @@index([rubroId])
  @@index([subrubroId])
  @@index([fechaVencimiento])
}

model Material {
  id           String   @id @default(cuid())
  // Código corto para identificar el material (ej. HIE-001).
  // Se genera automáticamente al crearlo y se puede editar después.
  codigo       String   @unique
  nombre       String
  unidad       String
  // Peso (en la unidad del material, ej. kg) de una barra/unidad física.
  // Permite convertir automáticamente al registrar una entrega que llega
  // contada en barras aunque el pedido esté cotizado por peso.
  pesoPorBarra Decimal? @db.Decimal(10, 3)
  rubroId      String?
  rubro        Rubro?   @relation(fields: [rubroId], references: [id])
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  pedidoItems           PedidoItem[]
  acopios               Acopio[]
  acopioPrecios         AcopioPrecio[]
  movimientosInventario InventarioMovimiento[]
}

// Cómo se reparte el monto de una línea de presupuesto a lo largo de sus meses.
//
// Existe porque el total y el calendario no alcanzan: una excavación de 90.000
// en tres meses no gasta 30.000 por mes, arranca fuerte y afloja. Con una sola
// forma de repartir, el flujo proyectado da un número plano que no se parece a
// la obra y no sirve para prever cuándo hace falta la plata.
//
// Son cuatro y no una curva libre a propósito: cubren los casos reales de una
// obra y se eligen de un vistazo. Dibujar una curva a mano sería más exacto y
// mucho menos usable.
enum CurvaPresupuesto {
  // Todos los meses lo mismo. El default, y lo correcto para gastos parejos
  // como alquileres o sueldos.
  UNIFORME
  // Empieza chico y termina grande (terminaciones, carpinterías).
  CRECIENTE
  // Empieza grande y termina chico (movimiento de suelos, demolición).
  DECRECIENTE
  // Poco al principio y al final, el grueso en el medio (estructura, albañilería).
  CAMPANA
}

// Una línea del presupuesto de una obra: cuánto se planea gastar en un rubro (o
// subrubro) y en qué tramo de la obra.
//
// Es el gemelo proyectado de MovimientoFondo. La diferencia de fondo es que un
// movimiento es un hecho con fecha, y esto es una intención con forma: un total,
// un tramo y una curva. Los montos mensuales NO se guardan, se derivan (ver
// src/lib/presupuesto.ts). Guardarlos convertiría esto en una planilla y
// obligaría a reescribir doce celdas para correr una barra un mes.
//
// El tramo se guarda como offset en meses desde Proyecto.fechaInicio y no como
// fechas absolutas: si la obra se atrasa dos meses, se corrige la fecha de
// inicio y el presupuesto entero se acomoda solo.
model PresupuestoItem {
  id         String    @id @default(cuid())
  proyectoId String
  proyecto   Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rubroId    String
  rubro      Rubro     @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  // Null = la línea presupuesta el rubro entero. Con subrubro, presupuesta esa
  // parte. Los dos niveles no se suman entre sí: si un rubro tiene subrubros
  // presupuestados, su total es la suma de ellos y la línea del rubro se ignora
  // (ver src/lib/presupuesto.ts).
  subrubroId String?
  subrubro   Subrubro? @relation(fields: [subrubroId], references: [id], onDelete: Cascade)

  // Siempre en dólares. Todo Flujo de fondos ya consolida en USD, y un
  // presupuesto a dos años en pesos se despega de la realidad antes de servir.
  montoUSD Decimal @db.Decimal(14, 2)

  // Mes de arranque contado desde el inicio de obra: 0 es el primer mes.
  mesInicio     Int              @default(0)
  duracionMeses Int              @default(1)
  curva         CurvaPresupuesto @default(UNIFORME)
  notas         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([proyectoId])
  @@index([rubroId])
  @@index([subrubroId])
}

model Pedido {
  id          String       @id @default(cuid())
  numero      Int
  proyectoId  String
  proyecto    Proyecto     @relation(fields: [proyectoId], references: [id])
  proveedorId String
  proveedor   Proveedor    @relation(fields: [proveedorId], references: [id])
  acopioId    String?
  acopio      Acopio?      @relation(fields: [acopioId], references: [id])
  // Factura que respalda este pedido, si la hay. La mayoría de los pedidos de
  // corralón no tiene: se juntan varios y se pagan sin comprobante, así que el
  // campo queda en null y el pedido funciona igual que siempre. Varios pedidos
  // pueden colgar de la misma factura (ver Factura).
  facturaId   String?
  factura     Factura?     @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  fecha       DateTime     @default(now())
  estado      EstadoPedido @default(PENDIENTE)
  notas       String?
  archivoUrl  String?
  creadoPorId String?
  creadoPor   User?        @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items    PedidoItem[]
  entregas Entrega[]

  @@unique([proyectoId, numero])
  @@index([proyectoId])
  @@index([proveedorId])
  @@index([acopioId])
  @@index([facturaId])
  @@index([estado])
}

model PedidoItem {
  id                String   @id @default(cuid())
  pedidoId          String
  pedido            Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material @relation(fields: [materialId], references: [id])
  cantidadPedida    Decimal  @db.Decimal(12, 2)
  unidad            String
  cantidadEntregada Decimal  @default(0) @db.Decimal(12, 2)
  precioUnitario    Decimal? @db.Decimal(12, 2)

  entregaItems EntregaItem[]

  @@index([pedidoId])
  @@index([materialId])
}

model Entrega {
  id              String   @id @default(cuid())
  pedidoId        String
  pedido          Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  fecha           DateTime @default(now())
  numeroRemito    String?
  remitoUrl       String?
  notas           String?
  registradoPorId String?
  registradoPor   User?    @relation("EntregaRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  items                 EntregaItem[]
  movimientosInventario InventarioMovimiento[]

  @@index([pedidoId])
}

model EntregaItem {
  id           String     @id @default(cuid())
  entregaId    String
  entrega      Entrega    @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  pedidoItemId String
  pedidoItem   PedidoItem @relation(fields: [pedidoItemId], references: [id])
  cantidad     Decimal    @db.Decimal(12, 2)

  @@index([entregaId])
  @@index([pedidoItemId])
}

model Acopio {
  id            String     @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto   @relation(fields: [proyectoId], references: [id])
  proveedorId   String
  proveedor     Proveedor  @relation(fields: [proveedorId], references: [id])
  tipo          TipoAcopio
  fecha         DateTime   @default(now())
  notas         String?
  montoTotal    Decimal?   @db.Decimal(12, 2)
  materialId    String?
  material      Material?  @relation(fields: [materialId], references: [id])
  cantidadTotal Decimal?   @db.Decimal(12, 2)
  unidad        String?
  createdAt     DateTime   @default(now())

  precios AcopioPrecio[]
  pedidos Pedido[]

  @@index([proyectoId])
  @@index([proveedorId])
  @@index([materialId])
}

model AcopioPrecio {
  id             String   @id @default(cuid())
  acopioId       String
  acopio         Acopio   @relation(fields: [acopioId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material @relation(fields: [materialId], references: [id])
  precioUnitario Decimal  @db.Decimal(12, 2)

  @@unique([acopioId, materialId])
  @@index([acopioId])
}

model InventarioMovimiento {
  id         String                   @id @default(cuid())
  materialId String
  material   Material                 @relation(fields: [materialId], references: [id])
  tipo       TipoMovimientoInventario
  cantidad   Decimal                  @db.Decimal(12, 2)
  fecha      DateTime                 @default(now())
  notas      String?
  createdAt  DateTime                 @default(now())
  entregaId  String?
  entrega    Entrega?                 @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([fecha])
  @@index([entregaId])
}

enum PrioridadTarea {
  ALTA
  MEDIA
  BAJA
}

// El circuito es PENDIENTE → EN_REVISION → COMPLETADA, pero el paso por
// revisión es opcional: al completar una tarea se elige si va a revisión o si
// se da por terminada ahí mismo. Desde revisión se aprueba (COMPLETADA) o se
// devuelve para corregir, que la vuelve a PENDIENTE con Tarea.aCorregir.
enum EstadoTarea {
  PENDIENTE
  EN_REVISION
  COMPLETADA
}

// Tarea pendiente de una obra. Se carga desde la pestaña "Tareas" de cada
// proyecto y se consulta en conjunto (todas las obras juntas) desde /tareas.
model Tarea {
  id             String         @id @default(cuid())
  proyectoId     String
  proyecto       Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  titulo         String
  descripcion    String?
  // El rubro es opcional: hay tareas que no caen en ninguno (ej. trámites
  // generales de la obra). Se usa onDelete por defecto (restrict) para no
  // borrar tareas si alguien elimina un rubro del catálogo.
  rubroId        String?
  rubro          Rubro?         @relation(fields: [rubroId], references: [id])
  prioridad      PrioridadTarea @default(MEDIA)
  estado         EstadoTarea    @default(PENDIENTE)
  completadaEl   DateTime?
  // Desde cuándo está esperando que alguien la revise. Ordena la lista de
  // revisión: primero lo que hace más tiempo que está trabado.
  enRevisionEl   DateTime?
  // La devolvieron de la revisión. Es un campo aparte y no un estado nuevo de
  // `EstadoTarea`: por dentro la tarea sigue PENDIENTE, sólo que la UI separa
  // estas en su propia solapa "A corregir" (ver `VistaTarea` en lib/tareas.ts)
  // para no mezclar lo que volvió rebotado con lo que todavía no se tocó. Se
  // apaga solo al volver a mandarla (`cambiarEstadoTarea`), así que de ahí no
  // regresa a Pendientes por su cuenta.
  aCorregir      Boolean        @default(false)
  // Qué hay que corregir, según quien la revisó. Es opcional: se puede
  // devolver sin escribir nada.
  correccionNota String?
  creadoPorId    String?
  creadoPor      User?          @relation("TareaCreadaPor", fields: [creadoPorId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Si viene de un plano del listado de Documentación (botón "Nueva tarea"),
  // el plano del que salió: al completarse esta tarea, el plano se tilda solo
  // (y si se reabre la tarea, el plano vuelve a quedar pendiente). Null en
  // las tareas que se cargan sueltas, sin pasar por Documentación.
  documentoId    String?
  documento      Documento?     @relation(fields: [documentoId], references: [id])

  asignados TareaAsignado[]
  items     TareaItem[]
  secciones TareaSeccion[]

  @@index([proyectoId])
  @@index([rubroId])
  @@index([estado])
  @@index([documentoId])
}

// Agrupa sub ítems dentro de una tarea, para las tareas largas que se dividen
// en bloques ("Documentación", "Obra", …). Es opcional: los sub ítems pueden
// colgar directo de la tarea, sin sección.
model TareaSeccion {
  id        String   @id @default(cuid())
  tareaId   String
  tarea     Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  titulo    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  items TareaItem[]

  @@index([tareaId])
}

// Checklist de una tarea: los pasos sueltos que se van tildando para ir
// completando la tarea. Al tildar el último no se completa sola: pregunta si va
// a revisión o si se da por terminada, igual que al tildar la tarea entera. Si
// se destilda uno estando completada, vuelve a pendiente.
model TareaItem {
  id         String        @id @default(cuid())
  tareaId    String
  tarea      Tarea         @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  // Null = el ítem cuelga directo de la tarea, sin sección. Se mantiene el
  // vínculo con la tarea aunque esté dentro de una sección: así el checklist
  // completo se lee de una sola consulta.
  seccionId  String?
  seccion    TareaSeccion? @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  texto      String
  completado Boolean       @default(false)
  // Orden manual dentro de su grupo: el alta los numera 0,1,2… así se muestran
  // siempre como los escribió el usuario, no por fecha de creación.
  orden      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([tareaId])
  @@index([seccionId])
}

// Relación N a N entre tareas y los usuarios responsables. Es una tabla propia
// (y no una relación implícita) para poder indexar por usuario y responder
// rápido "las tareas de tal persona" en la vista global.
model TareaAsignado {
  tareaId String
  tarea   Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tareaId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cómputos
// ---------------------------------------------------------------------------

// Unidad en la que se mide un ítem del cómputo.
//
// Es un enum y no un String libre (como Material.unidad) porque acá la unidad
// no es una etiqueta: decide qué se le pide al usuario al cargar una medición.
// Si el ítem es M2 la pantalla pide largo y ancho; si es M3 suma el alto; si
// es ML pide un largo solo. Con texto libre ("m2", "M2", "m²") esa decisión se
// vuelve una adivinanza y la carga deja de ser guiada.
//
// GLOBAL es la salida para lo que no se mide sino que se cuenta entero ("cartel
// de obra", "conexión de agua"): la medición queda con la cantidad y nada más.
enum UnidadComputo {
  M2
  M3
  ML
  UN
  KG
  GLOBAL
}

// Catálogo compartido de ítems: el repertorio de cosas que el estudio computa
// una y otra vez ("Contrapiso sobre terreno natural", "Mampostería de ladrillo
// hueco 12"). No pertenece a ninguna obra.
//
// Existe para que empezar el cómputo de una obra nueva no sea empezar de cero:
// se eligen los ítems del catálogo y se traen. Al traerlos se COPIAN (ver
// ComputoItem.tipoId), no se referencian, igual que los tipos de documento: si
// en esta obra el contrapiso va con otro espesor, se corrige acá sin ensuciar
// el catálogo ni las demás obras.
model ComputoItemTipo {
  id         String        @id @default(cuid())
  nombre     String
  unidad     UnidadComputo
  rubroId    String
  rubro      Rubro         @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  // DORMIDO. El cómputo dejó de clasificar por Subrubro cuando se separó del
  // flujo de fondos (ver ComputoSeccion). La columna queda por si se vuelve a
  // atar la medición a la clasificación de la plata; hoy no la escribe nadie.
  //
  // El catálogo no tiene sección: las secciones son de cada obra, y un tipo del
  // catálogo se trae a la obra y ahí recién cae en una.
  subrubroId String?
  subrubro   Subrubro?     @relation(fields: [subrubroId], references: [id], onDelete: SetNull)
  orden      Int           @default(0)
  activo     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  items ComputoItem[]

  @@unique([rubroId, nombre])
  @@index([rubroId])
  @@index([subrubroId])
}

// Un ítem del cómputo de una obra: qué se va a hacer o a comprar, en qué unidad
// se mide, y (por sus mediciones) cuánto.
//
// El cómputo se organiza como lo organiza el estudio: rubro → subrubro → ítems.
// El subrubro es el corte que ya existe en el gasto real (MANO DE OBRA /
// MATERIALES) y también el que separa las dos etapas de trabajo: primero se
// computa la mano de obra para que el contratista presupueste, y después, a
// medida que avanza la obra, los materiales. Que el cómputo caiga en los mismos
// dos baldes que el presupuesto y el flujo de fondos es lo que permite
// comparar lo computado con lo gastado sin traducir nada.
//
// La cantidad total NO se guarda: se deriva sumando las mediciones (ver
// src/lib/computos.ts), misma decisión que los montos mensuales de
// PresupuestoItem. Guardarla obligaría a recalcularla y reescribirla en cada
// alta, edición o borrado de una medición, y bastaría un error para que el
// cómputo mostrara un número que sus propias filas no justifican. Derivándola,
// el total siempre se puede defender: está a la vista de dónde sale.
//
// El rubro se copia en el ítem y no se lee del tipo de catálogo porque el ítem
// puede no venir del catálogo (tipoId en null) y porque el rubro es lo que lo
// ata al presupuesto y al flujo de fondos: tiene que estar siempre.
model ComputoItem {
  id          String           @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rubroId     String
  rubro       Rubro            @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  // La sección de obra dentro del rubro: MUROS, REVOQUES, CONTRAPISOS. Es la
  // grilla donde vive este ítem, y es una columna de esa grilla.
  //
  // Cascade y no SetNull: un ítem es una columna de su sección, no algo que
  // exista por su cuenta. Si se borra MUROS, "ladrillo hueco 12 de muros" no
  // queda flotando en ningún lado, se va con ella.
  //
  // Nullable por los ítems que se cargaron antes de que existieran las
  // secciones.
  seccionId   String?
  seccion     ComputoSeccion?  @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  // DORMIDO, igual que en ComputoItemTipo: el cómputo se separó del flujo de
  // fondos y ya no clasifica por Subrubro. No la escribe nadie.
  subrubroId  String?
  subrubro    Subrubro?        @relation(fields: [subrubroId], references: [id], onDelete: SetNull)
  // De dónde salió este ítem. Null = es propio de esta obra, no está en el
  // catálogo. Es sólo procedencia: cambiar el nombre acá no cambia el del
  // catálogo, y borrar el tipo no borra el ítem (SetNull).
  tipoId      String?
  tipo        ComputoItemTipo? @relation(fields: [tipoId], references: [id], onDelete: SetNull)
  nombre      String
  unidad      UnidadComputo
  // Porcentaje de desperdicio del ítem (ej. 10.00 = +10%). Se carga una vez, al
  // crear el ítem, junto con la unidad: el desperdicio es una propiedad del
  // material y de cómo se trabaja —un ladrillo se rompe siempre igual—, no de
  // la pared que se está midiendo. La grilla muestra las dos columnas, lo
  // medido y lo medido con el desperdicio aplicado.
  //
  // Null = sin desperdicio. No es lo mismo que 0: 0 es "lo pensé y no lleva".
  desperdicio Decimal?         @db.Decimal(5, 2)

  // ── Conversión a material ────────────────────────────────────────────────
  //
  // Hay ítems que se miden en una unidad y se compran en otra. Una pared se
  // mide en metros de pared, pero al corralón se le piden ladrillos, y el
  // corralón los entrega por palet. Son tres lecturas del mismo trabajo, y
  // antes de esto la segunda y la tercera se sacaban a mano en un papel aparte
  // —que es exactamente donde se cuelan los errores de pedido—.
  //
  // Se guarda acá y no como un ítem derivado aparte (ver ComputoMedicion.
  // origenId) porque no es otro trabajo: es la MISMA medición leída en otra
  // unidad. Un derivado tiene sus propias filas, su propio total y se puede
  // medir a mano; esto no, esto es una columna que se recalcula sola y que no
  // se puede escribir. Hacerlo derivado obligaría a crear un ítem "Ladrillos"
  // por cada pared y a mantener las dos columnas en sincronía a mano.
  //
  // Cuántas unidades de material entran por cada unidad medida: 15 ladrillos
  // por metro de pared, 8 kg de cemento por m² de revoque. Null = el ítem se
  // pide en la misma unidad en la que se mide y no hay nada que convertir.
  rinde       Decimal?         @db.Decimal(12, 4)
  // En qué queda la cuenta: UN para los ladrillos, KG para el cemento. Sólo
  // tiene sentido junto con `rinde`.
  rindeUnidad UnidadComputo?
  // Cuántas unidades de material vienen por bulto: 198 ladrillos por palet, 25
  // kg por bolsa. Null = se compra suelto y no hay bultos que contar.
  porBulto    Decimal?         @db.Decimal(12, 4)
  // Cómo se llama el bulto en la obra: "palet", "bolsa", "caja". Es la etiqueta
  // de la fila del pie; sin esto diría "bultos", que no lo dice nadie.
  bultoNombre String?

  // Marca y modelo del artefacto o grifería, cuando corresponde (ver rubro
  // Artefactos y griferías: "FV Siena blanco", "Hidromet 1a línea"). Es un
  // dato comercial y no entra en ninguna cuenta del cómputo; se imprime al
  // lado del nombre del ítem para que la orden de compra diga qué pieza
  // exacta es y no sólo "inodoro". Cualquier ítem lo puede tener, no sólo los
  // de ese rubro: no hay forma de saber de antemano a quién más le sirve.
  modelo      String?

  notas       String?
  orden       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  mediciones ComputoMedicion[]
  // Filas de otros ítems que salen de la cantidad de éste (ver
  // ComputoMedicion.origenId). Está declarada para que borrar un ítem que
  // alimenta a otros sea una decisión explícita y no una sorpresa.
  derivadas  ComputoMedicion[] @relation("MedicionOrigen")

  @@index([proyectoId])
  @@index([rubroId])
  @@index([seccionId])
  @@index([subrubroId])
  @@index([tipoId])
}

// Un renglón dentro de un ítem. Hay dos clases, y las dos son la misma fila
// porque las dos suman al mismo total:
//
//   MEDIDA   "Living — 1 × 5,20 × 4,30"      → origenId en null
//   DERIVADA "Sale de Mampostería × 15 +5%"  → origenId apunta al ítem de origen
//
// La fila medida es la razón de ser del módulo. El cómputo no es un número, es
// la lista de dónde sale ese número: quién lo revisa tiene que poder leer
// ambiente por ambiente y entender por qué el contrapiso da 148 m².
//
// La fila derivada es la segunda etapa: el material no se vuelve a medir, se
// calcula sobre lo ya computado. 1.240 m² de mampostería × 15 ladrillos = 18.600.
// Se modela como una fila más, y no como una "receta" aparte, porque en la obra
// real un material viene de VARIOS trabajos a la vez — el cemento sale de la
// mampostería, del revoque y del contrapiso — y con una fila por origen eso se
// suma solo, se lee en la misma tabla y se corrige renglón por renglón.
//
// Las tres dimensiones son opcionales porque cuáles se usan lo decide la unidad
// del ítem (ver UnidadComputo): M2 usa largo y ancho, M3 suma alto, ML usa
// largo solo, y UN/KG/GLOBAL ninguna. El parcial de la fila es la cantidad por
// las dimensiones que correspondan, y también se deriva.
//
// `deduccion` invierte el signo del parcial: es la forma de descontar los vanos
// sin obligar a cargar números negativos. Un revoque se computa como la pared
// entera y abajo se le restan las ventanas, que es exactamente como se mide en
// obra y deja el descuento a la vista en vez de escondido en una resta ya hecha.
model ComputoMedicion {
  id          String            @id @default(cuid())
  itemId      String
  item        ComputoItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Dónde se midió ("Living", "Eje 3 entre A y B"), o de qué sale si es
  // derivada. Es lo que hace legible el cómputo, pero no se exige: a veces el
  // ítem es una sola fila sin lugar.
  descripcion String?
  // En qué nivel de la obra va esta fila. El cómputo se mira y se paga por
  // planta, así que el renglón tiene que saber a cuál pertenece: el ítem se
  // computa una sola vez y adentro se abre por nivel.
  //
  // Null es válido y quiere decir "no es de una planta": la excavación, el
  // obrador o el cerco son de toda la obra. Las filas derivadas también van en
  // null, porque salen del TOTAL de otro ítem y ese total ya cruza los niveles.
  //
  // Restrict y no SetNull: borrar un nivel que tiene filas computadas no puede
  // mandarlas calladas a "Toda la obra". El total quedaría igual y el detalle
  // por planta se perdería sin que nadie se entere. Se bloquea y se avisa
  // cuántas filas hay que mover primero (ver src/actions/niveles-proyecto.ts).
  nivelId     String?
  nivel       NivelProyecto?    @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  // La otra clase de fila de la grilla: una que existe sólo en esta sección
  // ("SALA DE MÁQUINAS" adentro de MUROS). Ver ComputoFilaExtra.
  //
  // Es excluyente con nivelId: una medida está en una planta de la obra o en
  // una fila puntual de esta grilla, nunca en las dos. Con los dos en null la
  // fila es de toda la obra.
  //
  // Cascade y no Restrict, al revés que el nivel: la fila extra es de esta
  // grilla y de nadie más, así que al borrarla no hay ningún otro lado donde
  // esas medidas sigan queriendo decir algo. Igual la acción que la borra
  // bloquea si tiene algo cargado, para que la pérdida no pase de costado.
  filaExtraId String?
  filaExtra   ComputoFilaExtra? @relation(fields: [filaExtraId], references: [id], onDelete: Cascade)
  // En una fila medida: cuántas veces se repite esta medida (2 baños iguales,
  // 8 columnas), default 1 para que cargar una medida suelta sea escribir sólo
  // las dimensiones. En una fila derivada: el coeficiente por unidad del origen
  // (15 ladrillos por m² de mampostería).
  cantidad    Decimal           @default(1) @db.Decimal(12, 3)
  largo       Decimal?          @db.Decimal(12, 3)
  ancho       Decimal?          @db.Decimal(12, 3)
  alto        Decimal?          @db.Decimal(12, 3)
  deduccion   Boolean           @default(false)
  // Sólo en filas derivadas: el ítem del que sale la cantidad. Cascade y no
  // SetNull porque una fila derivada sin origen no es una fila incompleta, es
  // una fila sin sentido: su número entero salía de ahí.
  origenId    String?
  origen      ComputoItem?      @relation("MedicionOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  // Porcentaje que se le suma a la cantidad derivada por roturas, recortes y
  // sobrantes. Va acá y no metido en el coeficiente para que en el papel que se
  // manda a cotizar se lea "18.600 + 5%" y no un 15,75 que nadie puede discutir.
  desperdicio Decimal?          @db.Decimal(5, 2)
  orden       Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([itemId])
  @@index([origenId])
  @@index([nivelId])
  @@index([filaExtraId])
}
